# Environment Variables for Co-Work

# Google Gemini API key for server-side AI features
GEMINI_API_KEY=

# Optional: API base URL override (defaults to same origin in dev & prod)
VITE_API_URL=

# Optional: Base path for Vite assets (defaults to ./)
VITE_BASE_PATH=

# ─── PostgreSQL / Cloud SQL ───────────────────────────────────────────────────
# Cloud Run (production) — Unix socket via --add-cloudsql-instances flag:
#   DATABASE_URL="postgresql://APP_USER:PASSWORD@localhost/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE"
#
# Local dev option A — Cloud SQL Auth Proxy (unix socket, mirrors Cloud Run exactly):
#   Start proxy: cloud-sql-proxy --unix-socket /tmp/cloudsql PROJECT:REGION:INSTANCE
#   DATABASE_URL="postgresql://APP_USER:PASSWORD@localhost/DBNAME?host=/tmp/cloudsql/PROJECT:REGION:INSTANCE"
#
# Local dev option B — plain TCP (simplest, no proxy needed, use a local Postgres):
#   DATABASE_URL="postgresql://APP_USER:PASSWORD@localhost:5432/DBNAME"
DATABASE_URL=

# Cloud SQL instance connection name (used in gcloud run deploy --add-cloudsql-instances)
INSTANCE_CONNECTION_NAME=PROJECT:REGION:INSTANCE
